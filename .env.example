# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# SPORTS_API_KEY: Optional API key for API-Sports (e.g. https://api-sports.io)
SPORTS_API_KEY=MY_SPORTS_API_KEY

# ASSRT_TOKEN: Optional API token for ASSRT / Shooter.cn (e.g. https://assrt.net)
# Used for Chinese and Asian subtitles.
ASSRT_TOKEN=MY_ASSRT_TOKEN

# OPENSUBTITLES_API_KEY: Optional API key for OpenSubtitles.com REST API (https://opensubtitles.com)
OPENSUBTITLES_API_KEY=MY_OPENSUBTITLES_API_KEY
